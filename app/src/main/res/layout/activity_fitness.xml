<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fitness"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jouw doel"
                    android:textColor="@color/amber"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fitnessProfileSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nog geen persoonlijk profiel ingesteld"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/fitnessWeekStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button android:id="@+id/fitnessTodayTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vandaag" android:textColor="@color/on_amber" android:backgroundTint="@color/amber" />
                    <Button android:id="@+id/fitnessPlanTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Schema" android:textColor="@color/text_main" android:backgroundTint="@color/surface_raised" />
                    <Button android:id="@+id/fitnessFoodTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Eten" android:textColor="@color/text_main" android:backgroundTint="@color/surface_raised" />
                    <Button android:id="@+id/fitnessSuggestionsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Voorstellen" android:textColor="@color/text_main" android:backgroundTint="@color/surface_raised" />
                    <Button android:id="@+id/fitnessProgressTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Voortgang" android:textColor="@color/text_main" android:backgroundTint="@color/surface_raised" />
                    <Button android:id="@+id/fitnessProfileTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Profiel" android:textColor="@color/text_main" android:backgroundTint="@color/surface_raised" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/fitnessSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fitnessSectionBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/surface"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/fitnessPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/on_amber"
                android:backgroundTint="@color/amber" />

            <Button
                android:id="@+id/fitnessSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_main"
                android:backgroundTint="@color/surface_raised" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Veilig trainen: bouw rustig op. Stop bij pijn op de borst, flauwvallen, ernstige benauwdheid of plotselinge scherpe pijn. Bij gezondheidsproblemen of twijfel over inspanning is overleg met je huisarts verstandig."
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
