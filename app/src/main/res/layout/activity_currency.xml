<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Koers"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/rateStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="18dp"
        android:text="Koersen ophalen..."
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:text="Van"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <Button
        android:id="@+id/sourceCurrencyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:text="EUR"
        android:textColor="@color/text_main"
        android:backgroundTint="@color/surface" />

    <EditText
        android:id="@+id/amountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:hint="Bedrag in EUR"
        android:textColorHint="@color/text_dim"
        android:textColor="@color/text_main"
        android:background="@color/surface"
        android:padding="14dp"
        android:minHeight="50dp"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <Button
        android:id="@+id/swapCurrenciesButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="6dp"
        android:text="⇅ Wisselen"
        android:textColor="@color/amber" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:text="Naar"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <Button
        android:id="@+id/targetCurrencyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:text="SRD"
        android:textColor="@color/text_main"
        android:backgroundTint="@color/surface" />

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="18dp"
        android:padding="16dp"
        android:background="@color/surface"
        android:text="—"
        android:textColor="@color/text_main"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/refreshRateButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="Koersen verversen"
        android:textColor="@color/amber" />

</LinearLayout>
