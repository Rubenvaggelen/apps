<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE ONE FAMILY • MEDIA"
                android:textColor="@color/gold"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Films, Series &amp; Muziek"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:letterSpacing="0.015"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:text="Zoek films, series of muziek met één zoekbalk."
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/movieTitleInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Film, serie, nummer of artiest..."
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_the_one_input"
            android:padding="12dp"
            android:minHeight="52dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

        <Button
            android:id="@+id/movieSearchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="ZOEKEN"
            android:background="@drawable/bg_the_one_gold_button"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:textColor="@color/on_gold"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/musicPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_the_one_panel"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="The One"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The One"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Geen muziek actief"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:paddingTop="2dp" />

                <TextView
                    android:id="@+id/musicPlaybackState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestopt"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:paddingTop="2dp" />

            </LinearLayout>
        </LinearLayout>

        <WebView
            android:id="@+id/musicWebPlayer"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0.01"
            android:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/musicPreviousButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="⏮"
                android:textSize="20sp"
                android:background="@drawable/bg_the_one_blue_button"
                android:backgroundTint="@null"
            app:backgroundTint="@null"
                android:textColor="@color/text_main"
                android:gravity="center" />

            <Button
                android:id="@+id/musicPlayPauseButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="⏯"
                android:textSize="20sp"
                android:background="@drawable/bg_the_one_gold_button"
                android:backgroundTint="@null"
            app:backgroundTint="@null"
                android:textColor="@color/on_gold" />

            <Button
                android:id="@+id/musicStopButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="■"
                android:textSize="19sp"
                android:background="@drawable/bg_the_one_blue_button"
                android:backgroundTint="@null"
            app:backgroundTint="@null"
                android:textColor="@color/text_main" />

            <Button
                android:id="@+id/musicNextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⏭"
                android:textSize="20sp"
                android:background="@drawable/bg_the_one_blue_button"
                android:backgroundTint="@null"
            app:backgroundTint="@null"
                android:textColor="@color/text_main"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/movieResultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THE ONE FAMILY • BINNENKORT"
                        android:textColor="@color/gold"
                        android:textSize="9sp"
                        android:letterSpacing="0.14"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Marvel &amp; DC"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/upcomingLoadButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LADEN"
                    android:background="@drawable/bg_the_one_gold_outline"
                    android:backgroundTint="@null"
            app:backgroundTint="@null"
                    android:textColor="@color/gold"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/upcomingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/supremacyMixesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:text="SUPREMACY MIXEN   ›"
                android:textSize="16sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:minHeight="56dp"
                android:background="@drawable/bg_the_one_blue_button"
                android:backgroundTint="@null"
            app:backgroundTint="@null"
                android:textColor="@color/gold" />

            <Button
                android:id="@+id/remoteUsbMusicButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:text="USB THUIS   ›"
                android:textSize="16sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:minHeight="56dp"
                android:background="@drawable/bg_the_one_blue_button"
                android:backgroundTint="@null"
            app:backgroundTint="@null"
                android:textColor="@color/gold" />


            <LinearLayout
                android:id="@+id/musicResultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
