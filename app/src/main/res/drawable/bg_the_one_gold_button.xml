<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#E6B765" android:endColor="#B77A27" android:angle="270" />
            <stroke android:width="2dp" android:color="#EFC77E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#D8A451" android:endColor="#B77A2B" android:angle="270" />
            <stroke android:width="1dp" android:color="#E5B96E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
