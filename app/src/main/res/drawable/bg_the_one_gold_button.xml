<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFD078" android:endColor="#D98C2A" android:angle="270" />
            <stroke android:width="2dp" android:color="#FFE4A5" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#F1B85D" android:endColor="#D99538" android:angle="270" />
            <stroke android:width="1dp" android:color="#FFD37A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
