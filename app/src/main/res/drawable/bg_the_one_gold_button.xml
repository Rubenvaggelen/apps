<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFD27A" android:endColor="#D99538" android:angle="270" />
            <stroke android:width="2dp" android:color="#FFE3A5" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#E8AA4E" android:endColor="#C7862E" android:angle="270" />
            <stroke android:width="1dp" android:color="#F1BD68" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
