<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#153C55" android:endColor="#09131D" android:angle="270" />
            <stroke android:width="2dp" android:color="#64D7FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#0D1D2A" android:endColor="#070C12" android:angle="270" />
            <stroke android:width="1dp" android:color="#8020B8FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
