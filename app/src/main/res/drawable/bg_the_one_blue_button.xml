<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#174F70" android:endColor="#0B2533" android:angle="270" />
            <stroke android:width="2dp" android:color="#64D7FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#123A55" android:endColor="#081622" android:angle="270" />
            <stroke android:width="1dp" android:color="#20B8FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
