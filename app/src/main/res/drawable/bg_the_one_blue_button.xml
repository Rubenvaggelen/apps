<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#173C50" android:endColor="#0A1823" android:angle="270" />
            <stroke android:width="2dp" android:color="#4B9FC0" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#102A3A" android:endColor="#08131D" android:angle="270" />
            <stroke android:width="1dp" android:color="#2D789C" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
