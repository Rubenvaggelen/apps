<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#135476" android:endColor="#082235" android:angle="270" />
            <stroke android:width="2dp" android:color="#58D0FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#0D334A" android:endColor="#071A28" android:angle="270" />
            <stroke android:width="1dp" android:color="#20B8FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
