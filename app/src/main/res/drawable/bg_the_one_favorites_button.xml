<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#183B52"
                android:centerColor="#10283A"
                android:endColor="#0A1823"
                android:angle="270" />
            <stroke android:width="2dp" android:color="#F0B85A" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#102B40"
                android:centerColor="#0B2030"
                android:endColor="#07141F"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#D8A451" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
