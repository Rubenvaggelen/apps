{
  "name": "rutu-bbq-company-build",
  "version": "0.4.27",
  "description": "Rutu BBQ Company Build for Windows business operations",
  "main": "main.js",
  "author": "Rutu BBQ",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vanaggelen.rutubbq.simulator",
    "productName": "Company Build",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher.html",
      "business.html",
      "brand.css",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/rutu.ico"
    },
    "nsis": {
      "artifactName": "Company-Build-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Company Build"
    },
    "portable": {
      "artifactName": "Company-Build-${version}-Portable.${ext}"
    }
  }
}
