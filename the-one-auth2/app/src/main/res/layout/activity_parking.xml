<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Parkeren"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:text="Voeg adressen toe waar je een melding wilt om te betalen voor parkeren, zodra je binnen 50m aankomt. Beheer (verwijderen) doe je via Instellingen."
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/newAddressInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Bijv. Vianenstraat 31, Amsterdam"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_main"
            android:background="@color/surface"
            android:padding="12dp"
            android:minHeight="48dp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <Button
            android:id="@+id/addAddressButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Toevoegen"
            android:backgroundTint="@color/amber"
            android:textColor="@color/on_amber" />
    </LinearLayout>

    <TextView
        android:id="@+id/confirmationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
