<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lifestyle"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bewegen, trainen en het juiste moment om naar buiten te gaan."
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/lifestyleFitnessButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:text="🏋  Fitness"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_amber"
                android:backgroundTint="@color/amber" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Persoonlijk trainingsschema, eten, recepten, voorstellen en voortgang."
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/lifestyleWalkButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="18dp"
                android:text="☀  Wandelen / Step weer"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:backgroundTint="@color/surface_raised" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Bekijk de komende 7 dagen. The One adviseert de beste dagen vanaf 17 °C en let ook op regen en wind."
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/lifestyleWeatherContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:background="@color/surface"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lifestyleWeatherStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weeradvies"
                    android:textColor="@color/amber"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lifestyleWeatherAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />

                <Button
                    android:id="@+id/lifestyleWeatherRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Weer opnieuw bekijken"
                    android:textColor="@color/on_amber"
                    android:backgroundTint="@color/amber" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
