<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Laptop"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruben"
            android:textColor="@color/amber"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Maak deze Windows-laptop wakker vanuit slaapstand."
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <Button
            android:id="@+id/wakePcButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Laptop wakker maken"
            android:textColor="@color/on_amber"
            android:backgroundTint="@color/amber"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sleepPcButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Laptop in slaapstand"
            android:textColor="@color/text_main"
            android:backgroundTint="@color/surface"
            android:textStyle="bold" />

        <Button
            android:id="@+id/remotePcButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Op afstand verbinden"
            android:textColor="@color/text_main"
            android:backgroundTint="@color/surface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wakePcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Pincode vereist voordat het Wake-on-LAN-signaal wordt verstuurd."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Wakker maken werkt via Wake-on-LAN. Slaapstand werkt thuis direct en buitenshuis via Tailscale. Op afstand verbinden opent The One Remote."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
