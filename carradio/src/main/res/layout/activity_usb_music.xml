<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USB muziek"
            android:textColor="@color/amber"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/chooseUsbButton"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_amber_button"
            android:text="USB KIEZEN"
            android:textColor="@color/on_amber"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refreshUsbButton"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:background="@drawable/bg_outline"
            android:text="↻ VERNIEUWEN"
            android:textColor="@color/text_main"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/usbStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:text="USB wordt gezocht…"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="14dp">

        <TextView
            android:id="@+id/nowPlayingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Geen nummer geselecteerd"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0:00 / 0:00"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previousButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_outline"
                android:text="⏮ VORIGE"
                android:textColor="@color/text_main"
                android:textStyle="bold" />

            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1.2"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_amber_button"
                android:text="▶ AFSPELEN"
                android:textColor="@color/on_amber"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_outline"
                android:text="VOLGENDE ⏭"
                android:textColor="@color/text_main"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:text="NUMMERS OP USB"
        android:textColor="@color/amber"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/trackList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/line"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true" />

</LinearLayout>
