<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/bg" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Route" android:textColor="@color/amber" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Van" android:textColor="@color/text_dim" android:layout_marginTop="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/routeFrom" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:singleLine="true" android:textColor="@color/text_main" android:textColorHint="@color/text_dim" android:background="@drawable/bg_outline" android:paddingHorizontal="12dp"/>
        <Button android:id="@+id/routeCurrentLocationButton" android:layout_width="wrap_content" android:layout_height="54dp" android:text="Mijn locatie" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Naar" android:textColor="@color/text_dim" android:layout_marginTop="14dp"/>
    <EditText android:id="@+id/routeTo" android:layout_width="match_parent" android:layout_height="54dp" android:singleLine="true" android:hint="Adres of bestemming" android:textColor="@color/text_main" android:textColorHint="@color/text_dim" android:background="@drawable/bg_outline" android:paddingHorizontal="12dp"/>
    <Button android:id="@+id/routeCalculateButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:text="Route berekenen" android:backgroundTint="@color/amber" android:textColor="@color/on_amber"/>
</LinearLayout>
