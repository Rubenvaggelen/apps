<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileRoot"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:background="@drawable/bg_car_tile"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:scaleType="centerInside"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileBadge"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:minWidth="30dp"
        android:layout_gravity="top|end"
        android:gravity="center"
        android:paddingHorizontal="7dp"
        android:background="@drawable/bg_unread_count"
        android:textColor="@color/on_amber"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
