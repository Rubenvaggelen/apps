<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/carRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/the_one_logo"
        android:scaleType="centerCrop"
        android:alpha="0.12"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="The One"
                android:textColor="@color/amber"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text_main"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wachten op telefoon..."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/carAudioPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:visibility="gone"
            android:background="@drawable/bg_player_panel">

            <TextView
                android:id="@+id/carAudioTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Geen muziek actief"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/carAudioPrevious"
                android:layout_width="54dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="⏮"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:background="@drawable/bg_outline" />

            <TextView
                android:id="@+id/carAudioPlayPause"
                android:layout_width="58dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/on_gold"
                android:textSize="20sp"
                android:background="@drawable/bg_amber_button" />

            <TextView
                android:id="@+id/carAudioNext"
                android:layout_width="54dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:background="@drawable/bg_outline" />

            <TextView
                android:id="@+id/carAudioStop"
                android:layout_width="54dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="■"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:background="@drawable/bg_gold_outline" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <GridLayout
                android:id="@+id/tileGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false" />
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/youtubeOverlay"
        android:layout_width="560dp"
        android:layout_height="330dp"
        android:layout_gravity="end|bottom"
        android:layout_margin="14dp"
        android:visibility="gone"
        android:elevation="24dp"
        android:background="@drawable/bg_player_panel">

        <com.gmailorg.carradio.PassThroughFrameLayout
            android:id="@+id/youtubePlayerSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="52dp">

            <WebView
                android:id="@+id/youtubeWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg" />
        </com.gmailorg.carradio.PassThroughFrameLayout>

        <LinearLayout
            android:id="@+id/youtubeControls"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="@color/surface_raised">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="YouTube"
                android:textColor="@color/gold"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="8dp" />

            <TextView
                android:id="@+id/youtubeFadeButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:minWidth="90dp"
                android:paddingHorizontal="12dp"
                android:text="Tegels"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:background="@drawable/bg_outline" />

            <TextView
                android:id="@+id/youtubeFullscreenButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:minWidth="126dp"
                android:paddingHorizontal="12dp"
                android:text="⛶ Volledig"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:background="@drawable/bg_outline" />

            <TextView
                android:id="@+id/youtubeMinimizeButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:minWidth="108dp"
                android:paddingHorizontal="12dp"
                android:text="▣ Verklein"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:background="@drawable/bg_outline" />

            <TextView
                android:id="@+id/youtubeCloseButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/bg_gold_outline" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
