<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/appLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/amber"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="WhatsApp" />

        <TextView
            android:id="@+id/timeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:text="12:41" />
    </LinearLayout>

    <TextView
        android:id="@+id/titleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="Afzender" />

    <TextView
        android:id="@+id/textLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:text="Berichttekst" />

    <LinearLayout
        android:id="@+id/replyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/replyInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Typ een antwoord…"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_main"
            android:background="@color/surface_raised"
            android:padding="10dp"
            android:minHeight="44dp"
            android:inputType="text" />

        <Button
            android:id="@+id/replySendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Stuur"
            android:backgroundTint="@color/amber"
            android:textColor="#201505" />
    </LinearLayout>

</LinearLayout>
