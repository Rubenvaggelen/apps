<?xml version="1.0" encoding="utf-8"?>
<!--
    Gedeelde achtergrond van de "luxe" tegel-badge (gouden ring + donkergroene
    kern), gehaald uit ic_home_notifications_fancy.xml / ic_home_route_fancy.xml.
    Wordt gebruikt om zelf toegevoegde apps (WhatsApp, Google Home, en apps
    die de gebruiker zelf toevoegt) dezelfde stijl te geven als de vaste
    tegels: hun eigen icoon wordt hier bovenop getekend (zie HomeActivity.kt,
    buildBadgedAppIcon).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- luxe gouden buitenring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#F7D98B"
                android:centerColor="#D89A3A"
                android:endColor="#8E5B14" />
        </shape>
    </item>
    <!-- donkergroene kern -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#2D5A43"
                android:endColor="#10251C" />
            <stroke android:width="1dp" android:color="#F4D08A" />
        </shape>
    </item>
</layer-list>
