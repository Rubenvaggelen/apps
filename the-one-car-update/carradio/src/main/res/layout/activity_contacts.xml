<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="18dp"
    android:paddingBottom="78dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vaste WhatsApp-contacten"
        android:textColor="@color/amber"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alleen deze vaste contacten kunnen berichten naar The One Car sturen. Zet ieder contact afzonderlijk aan of uit. Losse contacten worden bij een nieuwe verbinding automatisch verwijderd."
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:paddingTop="5dp"
        android:paddingBottom="10dp" />

    <Button
        android:id="@+id/refreshContactsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↻ Vernieuw vanaf telefoon" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:id="@+id/contactContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
